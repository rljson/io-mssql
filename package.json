{
  "name": "@rljson/io-mssql",
  "version": "0.0.28",
  "description": "Rljson io-mssql description",
  "homepage": "https://github.com/rljson/io-mssql",
  "bugs": "https://github.com/rljson/io-mssql/issues",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/io-mssql.git"
  },
  "main": "dist/io-mssql.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm vite build && tsc && node scripts/copy-readme-to-dist.js",
    "build:cli": "node scripts/build-cli.js",
    "build:exe": "node scripts/build-cli.js && node scripts/build-exe.js",
    "test": "pnpm installConformanceTests && pnpm vitest --coverage --no-file-parallelism --run  && pnpm run lint",
    "prebuild": "pnpm run test",
    "prepublishOnly": "pnpm run build",
    "lint": "pnpm eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test",
    "installConformanceTests": "node scripts/install-conformance-tests.js"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-jsdoc": "^63.0.7",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.7.0",
    "jsdoc": "^4.0.5",
    "postject": "1.0.0-alpha.6",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@rljson/hash": "^0.0.18",
    "@rljson/io": "^0.0.69",
    "@rljson/is-ready": "^0.0.17",
    "@rljson/json": "^0.0.23",
    "@rljson/rljson": "^0.0.79",
    "mssql": "^12.6.0",
    "stream-json": "^3.5.0"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-tsdoc>@typescript-eslint/utils": "~8.61.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.20.0"
}
